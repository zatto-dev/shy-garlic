{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "VAR_JOB",
      "label": "Prometheus job",
      "description": "job_name of the scrape config that scrapes Shy Garlic",
      "type": "constant",
      "value": "shy-garlic"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "id": null,
  "version": 1,
  "uid": "shy-garlic",
  "title": "Shy Garlic — services",
  "tags": [
    "shy-garlic",
    "homelab",
    "uptime"
  ],
  "description": "Service health from Shy Garlic /metrics: what is up, degraded or down, 24-hour availability and response times.",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "# SHY GARLIC / services\nState of the services checked by Shy Garlic. The **Group** filter narrows everything; the time range applies to the history charts.\n\n🟢 Up &nbsp; 🟡 Degraded (answers, but wrong) &nbsp; 🔴 Down"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 19,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Shy Garlic version",
      "description": "Version from shyg_build_info.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#A78BFA"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (version) (shyg_build_info{job=\"$job\"})",
          "legendFormat": "{{version}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 34
        }
      },
      "id": 2,
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Up",
      "description": "Services whose last check succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(max by (group, service) (shyg_service_up{job=\"$job\", group=~\"$group\"}) == 1) or vector(0)",
          "legendFormat": "Up",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Degraded",
      "description": "The server answers, but not as expected (wrong status code or content).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#94A3B8"
              },
              {
                "value": 1,
                "color": "#FBBF24"
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(max by (group, service) (shyg_service_degraded{job=\"$job\", group=~\"$group\"}) == 1) or vector(0)",
          "legendFormat": "Degraded",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 4,
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Down",
      "description": "Services that did not answer the last check.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#94A3B8"
              },
              {
                "value": 1,
                "color": "#F87171"
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(max by (group, service) (2 - 2 * shyg_service_up{job=\"$job\", group=~\"$group\"} - shyg_service_degraded{job=\"$job\", group=~\"$group\"}) == 2) or vector(0)",
          "legendFormat": "Down",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 5,
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Availability",
      "description": "Average over all services: share of successful checks in the last 24 h (computed by Shy Garlic). Green ≥ 99.9 %, yellow ≥ 99 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#F87171"
              },
              {
                "value": 99,
                "color": "#FBBF24"
              },
              {
                "value": 99.9,
                "color": "#34D399"
              }
            ]
          },
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(shyg_service_availability_ratio{job=\"$job\", group=~\"$group\", window=\"24h\"}) * 100",
          "legendFormat": "Availability",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Median resp.",
      "description": "Typical response time (median) across all services that answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              },
              {
                "value": 300,
                "color": "#FBBF24"
              },
              {
                "value": 1000,
                "color": "#F87171"
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "quantile(0.5, shyg_service_response_seconds{job=\"$job\", group=~\"$group\"}) * 1000",
          "legendFormat": "Median resp.",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "p95 resp.",
      "description": "Response time, 95th percentile: only the slowest ~5 % of services answer slower.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              },
              {
                "value": 300,
                "color": "#FBBF24"
              },
              {
                "value": 1000,
                "color": "#F87171"
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "quantile(0.95, shyg_service_response_seconds{job=\"$job\", group=~\"$group\"}) * 1000",
          "legendFormat": "p95 resp.",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 42
        }
      },
      "id": 8,
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "01 / WHAT IS WRONG NOW",
      "description": "Only services that are degraded or down. “Last up” = the last successful check within 24 h; if there was none in 24 h, it shows the start of the data (then “For” means at least). 24-hour availability is in the table below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "All services up ✓",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Up",
                        "color": "#34D399",
                        "index": 0
                      },
                      "1": {
                        "text": "Degraded",
                        "color": "#FBBF24",
                        "index": 1
                      },
                      "2": {
                        "text": "Down",
                        "color": "#F87171",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "#34D399"
                    },
                    {
                      "value": 1,
                      "color": "#FBBF24"
                    },
                    {
                      "value": 2,
                      "color": "#F87171"
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic",
                  "applyToRow": false
                }
              },
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last up"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MMM D, HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "For"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (group, service) (2 - 2 * shyg_service_up{job=\"$job\", group=~\"$group\"} - shyg_service_degraded{job=\"$job\", group=~\"$group\"}) > 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max by (group, service) (max_over_time(timestamp(shyg_service_up{job=\"$job\", group=~\"$group\"} == 1)[24h:30s])) or max by (group, service) (min_over_time(timestamp(shyg_service_up{job=\"$job\", group=~\"$group\"})[24h:30s]))) * 1000 and on (group, service) (max by (group, service) (2 - 2 * shyg_service_up{job=\"$job\", group=~\"$group\"} - shyg_service_degraded{job=\"$job\", group=~\"$group\"}) > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - (max by (group, service) (max_over_time(timestamp(shyg_service_up{job=\"$job\", group=~\"$group\"} == 1)[24h:30s])) or max by (group, service) (min_over_time(timestamp(shyg_service_up{job=\"$job\", group=~\"$group\"})[24h:30s]))) and on (group, service) (max by (group, service) (2 - 2 * shyg_service_up{job=\"$job\", group=~\"$group\"} - shyg_service_degraded{job=\"$job\", group=~\"$group\"}) > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "State",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "group": "Group",
              "service": "Service",
              "Value #A": "State",
              "Value #B": "Last up",
              "Value #C": "For"
            },
            "indexByName": {
              "Value #A": 0,
              "service": 1,
              "group": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "bargauge",
      "title": "SLOWEST NOW",
      "description": "Response time of the last check, slowest first. Services that did not answer have no time. Green < 300 ms, yellow < 1 s, red ≥ 1 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              },
              {
                "value": 300,
                "color": "#FBBF24"
              },
              {
                "value": 1000,
                "color": "#F87171"
              }
            ]
          },
          "min": 0,
          "max": null,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(max by (group, service) (shyg_service_response_seconds{job=\"$job\", group=~\"$group\"}) * 1000)",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "manual",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 14,
        "maxVizHeight": 22,
        "text": {
          "titleSize": 13,
          "valueSize": 15
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "02 / ALL SERVICES — NOW",
      "description": "Every service: state, 24-hour availability (bar starts at 90 %), last response time and how long ago it was checked (yellow after 2 min, red after 5 min — with the default 30 s interval that means checks have stalled). Problems on top.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#34D399"
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
